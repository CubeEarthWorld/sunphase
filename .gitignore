# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Reproducible benchmark generated files
/benchmark/baseline/tool/
/benchmark/*.exe
/benchmark/*.pdb

# Local exploratory diagnostics; final timings and allocation status are tracked.
/benchmark/*-initial.jsonl
/benchmark/allocations.json
/benchmark/allocation-log.txt
